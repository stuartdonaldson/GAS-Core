
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Node / Playwright (dev-only; never vendored into a consumer clasp deploy)
node_modules/

# Tier 3 Playwright (gas-playwright-testing): captured Google session + artifacts.
# .auth/user.json holds a live session — MUST NOT be committed.
.auth/
test-results/
playwright-report/

# Local dev secrets (Drive folder paths, Axiom tokens, etc.) — never commit, copy
# from the corresponding local.settings.example.json instead.
local.settings.json

# Personal editor theming (Peacock color customization) — per-machine preference,
# not project config.
.vscode/
